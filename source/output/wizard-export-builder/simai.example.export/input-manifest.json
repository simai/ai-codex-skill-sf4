{
  "schema_version": "1.0.0",
  "solution_code": "simai.example.export",
  "solution_name": "SIMAI Example Export",
  "source_site_root": "/Users/rim/Sites/university.test",
  "description": {
    "name": "Мастер упаковки SIMAI Example",
    "storage_code": "simai_example_export",
    "primary_color": "#E53935",
    "secondary_color": "#2196F3",
    "background_color": "#263238"
  },
  "export": {
    "output_dir": "/.last_version/simai.example.export"
  },
  "modules": [
    "simai.sf4university",
    "simai.backup",
    "simai.property",
    "simai.property4iblock"
  ],
  "copy": [
    {
      "source": "/bitrix/components/simai",
      "destination": "/.last_version/simai.example.export/install/bitrix/components/simai",
      "name": "Копирование компонентов SIMAI"
    },
    {
      "source": "/bitrix/templates/.default",
      "destination": "/.last_version/simai.example.export/install/bitrix/templates/.default",
      "name": "Копирование шаблона .default"
    },
    {
      "source": "/upload/medialibrary",
      "destination": "/.last_version/simai.example.export/install/ru/root/upload/medialibrary",
      "name": "Копирование медиабиблиотеки"
    }
  ],
  "public_copy": [
    {
      "source": "/ru",
      "destination": "/.last_version/simai.example.export/install/ru/site",
      "name": "Копирование публичных файлов"
    },
    {
      "source": "/urlrewrite.php",
      "destination": "/.last_version/simai.example.export/install/ru/config/urlrewrite.php",
      "name": "Копирование urlrewrite"
    }
  ],
  "data_exports": {
    "site": true,
    "mail": false,
    "mail_templates": false,
    "usergroups": [
      "user_editor"
    ],
    "iblock_types": true,
    "options": {
      "main": [
        "email_from",
        "site_name",
        "auth_components_template",
        "map_top_menu_type",
        "map_left_menu_type"
      ],
      "fileman": [
        "menutypes"
      ],
      "simai.backup": [
        "BuMode"
      ]
    }
  },
  "iblocks": [
    "sf-ru-doc-common"
  ],
  "php_interface_snippets": [
    {
      "dir": "/.last_version/simai.example.export/install/ru/php_interface",
      "filename": "dbconn.add.php",
      "text": "define(\"SF_SOLUTION\",\"simai.example.export\");"
    }
  ],
  "encoding": {
    "win1251": true,
    "paths": [
      "/.last_version/simai.example.export/"
    ]
  },
  "archive": {
    "enabled": false,
    "source": "/.last_version/simai.example.export",
    "destination": "/.last_version/simai.example.export.zip"
  },
  "cleanup": {
    "enabled": false,
    "paths": [
      "/.last_version/simai.example.export/"
    ]
  }
}